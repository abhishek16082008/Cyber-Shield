# ============================================================================
# Cyber Shield — Edge Function secrets (SERVER-SIDE ONLY)
# ----------------------------------------------------------------------------
# These are the THIRD-PARTY provider keys used by the analyze-email function.
# They are NEVER exposed to the browser. Do not commit real values.
#
# Two ways to configure them (do this later, from VS Code):
#
#   A) One at a time:
#        supabase secrets set VIRUSTOTAL_API_KEY=your_real_key
#        supabase secrets set GOOGLE_WEBRISK_API_KEY=your_real_key
#        supabase secrets set ABUSEIPDB_API_KEY=your_real_key
#        supabase secrets set MXTOOLBOX_API_KEY=your_real_key
#        supabase secrets set MAXMIND_LICENSE_KEY=your_real_key
#
#   B) From a local env file (copy this to supabase/.env and fill it in):
#        supabase secrets set --env-file supabase/.env
#
# If a key is missing, that provider reports "not_configured" — the analysis
# never returns a false "safe" result.
#
# NOTE: SUPABASE_URL and SUPABASE_ANON_KEY are injected automatically into
# Edge Functions by the platform — you do NOT set those here.
# ============================================================================

VIRUSTOTAL_API_KEY=
GOOGLE_WEBRISK_API_KEY=
ABUSEIPDB_API_KEY=
MXTOOLBOX_API_KEY=
MAXMIND_LICENSE_KEY=
