# ============================================================================
# Cyber Shield backend — environment variables
# Copy this file to ".env" and fill in values. NEVER commit the real .env.
# ============================================================================

# Secret used to sign login tokens (JWT). Use a long random string.
# Generate one with:  python3 -c "import secrets; print(secrets.token_hex(32))"
JWT_SECRET=change-me-to-a-long-random-string

# How long a login stays valid, in minutes.
ACCESS_TOKEN_MINUTES=1440

# Where the frontend runs (for CORS). Comma-separate multiple origins.
FRONTEND_ORIGINS=http://localhost:5173,http://localhost:5174

# SQLite database file (default is fine for local dev).
DATABASE_URL=sqlite:///./cyber_shield.db

# --- Third-party provider API keys (server-side only, optional) --------------
# If a key is blank, that provider reports "not_configured" — never a false
# "safe" result. Fill these in when you have them.
VIRUSTOTAL_API_KEY=
GOOGLE_WEBRISK_API_KEY=
ABUSEIPDB_API_KEY=
MXTOOLBOX_API_KEY=
MAXMIND_LICENSE_KEY=
MAXMIND_ACCOUNT_ID=
