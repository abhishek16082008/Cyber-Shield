# ---------------------------------------------------------------------------
# Cyber Shield — frontend environment variables
# ---------------------------------------------------------------------------
# Copy this file to ".env" and fill in the values, then restart `npm run dev`.
#
# IMPORTANT — what is safe here:
#   - The Supabase URL and the "anon" (publishable) key are PUBLIC by design.
#     They are safe to ship in frontend code; Row Level Security protects data.
#   - NEVER put a service_role key, or any provider secret
#     (VirusTotal / AbuseIPDB / etc.) in this file. Those live only in the
#     Supabase Edge Function secrets, never in the browser.
#
# If you leave these blank, the app still runs fully using MOCK auth + MOCK
# data (localStorage). Fill them in to connect a real Supabase project.
# ---------------------------------------------------------------------------

VITE_SUPABASE_URL=
VITE_SUPABASE_ANON_KEY=

# Base URL for the analysis API (Supabase Edge Function or your FastAPI host).
# Leave blank to use the mock analyzer built into the frontend.
VITE_API_BASE_URL=
